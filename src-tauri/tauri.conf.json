{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EveryMD",
  "version": "0.2.0",
  "identifier": "com.everymd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EveryMD",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "upgradeMode": "remove"
      }
    }
  }
}
